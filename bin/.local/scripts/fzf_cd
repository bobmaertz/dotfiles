#!/usr/bin/env bash 

if [[ $# -eq 1 ]]; then
    selected=$1
else
    if command -v fd >/dev/null 2>&1; then
        selected=$(fd --type d --max-depth 1 . ~/personal ~/work ~/.config $SESSIONIZER_DIRS | fzf)
    else
        selected=$(find ~/personal ~/work ~/.config $SESSIONIZER_DIRS -mindepth 1 -maxdepth 1 -type d | fzf)
    fi
fi

cd $selected 
