#!/usr/bin/env bash
# fzf over existing tmux sessions, most recently used first.
# The current session is excluded, so hitting the keybind and pressing
# Enter without typing switches to the previous session.
# (via https://raine.dev/blog/my-tmux-setup/)

current=$(tmux display-message -p '#S')

# session_last_attached is empty for never-attached sessions; default it
# to 0 so the sort field is always present
choice=$(tmux list-sessions -F '#{?session_last_attached,#{session_last_attached},0} #{session_name}' \
    | sort -rn \
    | cut -d' ' -f2- \
    | grep -Fxv "$current" \
    | fzf --reverse --no-info --prompt='session> ') || exit 0

[[ -z $choice ]] && exit 0

tmux switch-client -t "$choice"
